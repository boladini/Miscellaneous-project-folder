# ---- Core (REQUIRED in production) -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://lab:lab@localhost:5432/lab
# demo = synthetic data namespace; live = real sourced observations (paper only)
LAB_MODE=demo
SECRET_KEY=replace-with-64-random-characters
# owner login (created on first start)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# true behind HTTPS in production
COOKIE_SECURE=false
# set to enable POST /internal/cron/tick for a managed scheduler
CRON_SECRET=
# only if the SPA is hosted on another origin
# CORS_ORIGINS=https://your-frontend.example.com

# ---- Schedules / timezone ----------------------------------------------------------------
DISPLAY_TIMEZONE=America/Chicago
DAILY_DATA_READY_HOUR_ET=18
DAILY_DATA_READY_MINUTE_ET=30

# ---- Market data (live mode) -------------------------------------------------------------
# tiingo (recommended) | alphavantage | stooq
MARKET_PROVIDER=tiingo
TIINGO_API_KEY=
# needed for earnings events (event-driven strategies)
ALPHAVANTAGE_API_KEY=
BENCHMARK_SYMBOL=SPY
# comma-separated; default is a 40-name large-cap universe
# MARKET_UNIVERSE=SPY,QQQ,...

# ---- AI / research -----------------------------------------------------------------------
# auto | anthropic | template
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# per run (hard cap; no unlimited loops)
RESEARCH_MAX_LLM_CALLS=12
# per run
RESEARCH_MAX_COST_USD=2.0
# optional polite-pool contact for OpenAlex/Crossref
OPENALEX_MAILTO=
# "YourName yourname@domain.com" (SEC fair-access policy)
SEC_USER_AGENT=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=

# ---- Email notifications (optional) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
